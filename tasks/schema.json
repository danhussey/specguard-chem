{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecGuard-Chem sgchem_v1 Task",
  "type": "object",
  "required": [
    "task_id",
    "suite",
    "bundle_id",
    "task_type",
    "task_family",
    "protocol",
    "prompt_template",
    "rendered_agent_input",
    "agent_visible_hash",
    "input",
    "spec_id",
    "spec_instance_hash",
    "scoring",
    "expected",
    "expected_action",
    "oracle_type",
    "evidence",
    "budgets",
    "generation"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "suite": {"type": "string"},
    "bundle_id": {"type": "string"},
    "task_type": {
      "type": "string",
      "enum": [
        "construct_feasible",
        "repair_near_miss",
        "repair_multi_violation",
        "audit_accept",
        "audit_reject",
        "abstain_contradiction",
        "boundary_precision",
        "smiles_invariance",
        "interrupt_resume",
        "tool_forced_l3"
      ]
    },
    "task_family": {"type": "string"},
    "protocol": {"enum": ["L1", "L2", "L3"]},
    "prompt": {"type": "string"},
    "prompt_template": {"type": "string"},
    "rendered_agent_input": {"type": "string", "minLength": 1},
    "agent_visible_payload": {"type": "object"},
    "agent_visible_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input": {"type": "object"},
    "spec_id": {"type": "string"},
    "spec_instance_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scoring": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {"type": "string"},
        "secondary": {"type": "string"}
      },
      "additionalProperties": false
    },
    "expected": {"type": "string", "enum": ["PASS", "ABSTAIN", "FAIL"]},
    "expected_action": {"type": "string", "enum": ["ACCEPT", "REJECT", "ABSTAIN"]},
    "oracle_type": {
      "type": "string",
      "enum": [
        "feasible_witness",
        "repair_witness",
        "violation_certificate",
        "unsat_certificate",
        "equivalence_certificate",
        "boundary_certificate",
        "interrupt_certificate"
      ]
    },
    "evidence": {"type": "object"},
    "task_constraints": {"type": "object"},
    "budgets": {
      "type": "object",
      "required": ["max_steps", "max_proposals", "max_verify_calls", "max_total_verifier_calls"],
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1},
        "max_proposals": {"type": "integer", "minimum": 0},
        "max_verify_calls": {"type": "integer", "minimum": 0},
        "max_total_verifier_calls": {"type": "integer", "minimum": 0},
        "max_edit_cost": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "required": [
        "seed",
        "stage",
        "source_molecule_id",
        "source_canonical_smiles",
        "curation_status"
      ],
      "properties": {
        "seed": {"type": "integer"},
        "stage": {"type": "string"},
        "source_molecule_id": {"type": ["string", "null"]},
        "source_canonical_smiles": {"type": ["string", "null"]},
        "scaffold_hash": {"type": ["string", "null"]},
        "curation_status": {"type": "string"},
        "curation_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "interrupt": {"type": "object"},
    "intentional_pair": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"task_type": {"const": "construct_feasible"}}},
      "then": {"properties": {"oracle_type": {"const": "feasible_witness"}}}
    },
    {
      "if": {"properties": {"task_type": {"const": "audit_reject"}}},
      "then": {"properties": {"expected_action": {"const": "REJECT"}, "oracle_type": {"const": "violation_certificate"}}}
    },
    {
      "if": {"properties": {"task_type": {"const": "abstain_contradiction"}}},
      "then": {"properties": {"expected_action": {"const": "ABSTAIN"}, "oracle_type": {"const": "unsat_certificate"}}}
    }
  ],
  "additionalProperties": true
}
